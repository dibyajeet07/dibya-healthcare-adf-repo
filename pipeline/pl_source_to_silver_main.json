						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_SqlTable",
						"type": "DatasetReference"
					}
				}
			}
		],
		"folder": {
			"name": "healthcare-project"
		},
		"annotations": []
	}
}