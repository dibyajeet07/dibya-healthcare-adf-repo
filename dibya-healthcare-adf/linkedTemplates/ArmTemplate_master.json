{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dibya-healthcare-adf"
		},
		"ls_AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncproject23.dfs.core.windows.net/"
		},
		"ls_AzureDatabricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1007-173628-qkty610b"
		},
		"ls_KeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresynckv23.vault.azure.net/"
		},
		"ls_PostgreSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-wispy-lab-az07ttk3-pooler.c-3.ap-southeast-1.aws.neon.tech"
		},
		"ls_PostgreSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_PostgreSql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"ls_SqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresyn-server23.database.windows.net"
		},
		"ls_SqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-caresyn"
		},
		"ls_SqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "databeli"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dibya-healthcare-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('ls_AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"ls_KeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_KeyVault_properties_typeProperties_baseUrl')]"
					},
					"ls_AzureDatabricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_AzureDatabricks_properties_typeProperties_existingClusterId')]"
					},
					"ls_PostgreSql_properties_typeProperties_server": {
						"value": "[parameters('ls_PostgreSql_properties_typeProperties_server')]"
					},
					"ls_PostgreSql_properties_typeProperties_database": {
						"value": "[parameters('ls_PostgreSql_properties_typeProperties_database')]"
					},
					"ls_PostgreSql_properties_typeProperties_username": {
						"value": "[parameters('ls_PostgreSql_properties_typeProperties_username')]"
					},
					"ls_SqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('ls_SqlDatabase1_properties_typeProperties_server')]"
					},
					"ls_SqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('ls_SqlDatabase1_properties_typeProperties_database')]"
					},
					"ls_SqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('ls_SqlDatabase1_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}